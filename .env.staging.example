# Dexplora STAGING (Vercel Preview for the staging branch)
# Use a separate MongoDB database or cluster. Never connect staging to production data.
MONGODB_URI=mongodb+srv://STAGING_USER:STAGING_PASSWORD@YOUR_CLUSTER.mongodb.net/dexplora_staging
MONGODB_DB=dexplora_staging
JWT_SECRET=GENERATE_A_DISTINCT_RANDOM_SECRET_FOR_STAGING
NEXT_PUBLIC_SITE_URL=https://YOUR-STAGING-PREVIEW-URL.vercel.app

# Keep all outgoing automation OFF in staging.
EMAIL_AUTOMATION_ENABLED=false
WHATSAPP_AUTOMATION_ENABLED=false

# Set only if you want to manually send a test email from staging.
# SMTP_USER=
# SMTP_APP_PASSWORD=
# SMTP_FROM=

# Use independent secrets if testing cron endpoints.
# CRON_SECRET=
